# ===== 超大原始数据集（GitHub 100MB 上限；下载方式见 README 第六节） =====
OHR-Bench/
chinook-database/

# ===== 环境与密钥 =====
deploy/.env
.env
*.key

# ===== Python =====
__pycache__/
*.pyc
.venv/
.venv-formula/
.cache/

# ===== 系统文件 =====
.DS_Store
Thumbs.db
.repo-state/

# ===== 上游仓库自身的 git 元数据（防止误嵌套提交） =====
*/.git/

# ===== 竞赛资料（非数据库内容，暂不入库） =====
/*.pdf

# ===== 临时提取文件 =====
saiti_text.txt
spec_text.txt

# 页面预览由摄取/评测生成；历史已跟踪预览不受影响。
/data/object_store/page_images/
/data/object_store/cad_sources/
/tmp/

# 本地验证脚本、临时凭据和预览中间文件
/work/

# 浏览器上传的本地暂存文件不进入版本库
/data/cad_demo/development/upload-*
/data/cad_demo/authorized/upload-*
/data/dimension_demo/development/upload-*
/data/dimension_demo/authorized/upload-*

# 通用上传管道（scripts/eval_qa_samples.py 等）的暂存文件是运行时数据，不是仓库内容
/data/uploads/

# 交付材料的生成中间产物（DOCX/PPTX 构建脚本保持入库以便复现，只挡编译缓存）
/交付/_build/__pycache__/

# Native PDF preparation sources and private attempt products are runtime data.
/data/object_store/pdf_prepared/

# ===== 知识库样本 PDF 白名单 =====
# 只忽略知识库目录下新落入/被外部工具写入的 PDF（曾发生 field-test-*.pdf 被误摄取）；
# 下面 12 份演示 PDF 由 data/knowledge_base/manifest.json 声明，逐条放行。
/data/knowledge_base/*.pdf
!/data/knowledge_base/01_重点产品市场分析报告_2025.pdf
!/data/knowledge_base/02_渠道运营策略白皮书.pdf
!/data/knowledge_base/03_2025年分区域经营数据简报.pdf
!/data/knowledge_base/04_售后服务与退款管理制度.pdf
!/data/knowledge_base/05_经营指标核算与计算公式说明.pdf
!/data/knowledge_base/06_2025年度经营分析报告.pdf
!/data/knowledge_base/07_门店巡检记录_2025年12月_扫描版.pdf
!/data/knowledge_base/08_产品质检报告_数码品类_扫描版.pdf
!/data/knowledge_base/09_无线降噪耳机Pro产品手册.pdf
!/data/knowledge_base/10_零售演示库数据字典.pdf
!/data/knowledge_base/11_客户服务话术手册.pdf
!/data/knowledge_base/12_财务指标核算办法.pdf

# ===== 运行时产物与日志 =====
/output/
*.log
# 评测、隔离回归与审计脚本的输出目录：每次运行自动生成，不入库
/reports/

# ===== Vue 前端构建产物 =====
# 由 frontend/ 执行 `npm run deploy` 生成。文件名带内容哈希，每构建一次就是
# 全部文件换名，多人协作时每次 pull 都会在这些压缩产物上冲突且无法手工合并，
# 因此不入库：拉下来先跑一次 npm run deploy 即可（api.py 在产物缺失时会返回
# 503 并提示去构建）。
/web/vue/
